# ── Database (test) ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5433
DB_NAME=candlealert_test
DB_USER=candlealert
DB_PASS=secret

# ── Binance ──────────────────────────────────────────────────────────────────
BINANCE_WS_URL=wss://localhost:9999
BINANCE_BASE_URL=https://api.binance.com

# ── Timeframes ────────────────────────────────────────────────────────────────
INTERVAL=5m,15m,1h

# ── Telegram (fake — not called during tests) ─────────────────────────────────
TELEGRAM_BOT_TOKEN=test_token
TELEGRAM_CHAT_ID=123456789

# ── Polymarket ────────────────────────────────────────────────────────────────
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_WINNER_COUNT=10

# ── Signal ────────────────────────────────────────────────────────────────────
SNAPSHOT_WINDOW_MS=10000
SIGNAL_TEST_MODE=false

# ── Application ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=test
LOG_LEVEL=error
