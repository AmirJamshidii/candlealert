{
  "name": "amir-bot",
  "version": "1.0.0",
  "description": "Binance candle monitor with Telegram alerts",
  "main": "dist/index.js",
  "scripts": {
    "docker:build": "docker build -t amir-bot .",
    "docker:up": "docker compose up",
    "docker:up:detached": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.12.0",
    "@types/pg": "^8.11.11",
    "@types/node-cron": "^3.0.11"
  }
}
