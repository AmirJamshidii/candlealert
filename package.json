{
  "name": "amir-bot",
  "version": "1.0.0",
  "description": "Binance candle monitor with Telegram alerts",
  "main": "dist/index.js",
  "scripts": {
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:up:detached": "docker compose up -d",
    "docker:down": "docker compose down",
    "build": "tsc && cp src/modules/health/chart.html dist/modules/health/",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "dependencies": {
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "typescript": "^5.9.3"
  }
}
